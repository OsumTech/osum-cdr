# Install with `crontab -e` as root. Ensure the VPS timezone is UTC.
# Change /root/apps/osum-cdr if you cloned to another directory.
*/5 * * * * /bin/sh /root/apps/osum-cdr/deploy/run-job.sh sync-cdr >> /var/log/osum-cdr-sync.log 2>&1
5 0 * * * /bin/sh /root/apps/osum-cdr/deploy/run-job.sh nightly >> /var/log/osum-cdr-billing.log 2>&1
17 3,15 * * * /bin/sh /root/apps/osum-cdr/deploy/run-job.sh renew-certificate >> /var/log/osum-cdr-certbot.log 2>&1
